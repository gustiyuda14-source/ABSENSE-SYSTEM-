# Test Environment Configuration

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/absense_test

# JWT
JWT_SECRET=test-secret-key-do-not-use-in-production
JWT_EXPIRATION=24h

# Server
PORT=3001
NODE_ENV=test

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=error

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Geofence
DEFAULT_GEOFENCE_RADIUS_METERS=100

# Penalties
PENALTY_PER_MINUTE=5000
GRACE_PERIOD_MINUTES=5

# Redis (optional for tests)
REDIS_URL=redis://localhost:6379

# External Services (mocked in tests)
EMAIL_SERVICE_URL=http://localhost:3001/mock/email
SMS_SERVICE_URL=http://localhost:3001/mock/sms
